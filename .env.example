# ---------------------------------------------------------------------------
# CalDrop environment variables
# Copy to `.env.local` for local development. Never commit real values.
# ---------------------------------------------------------------------------

# --- OpenAI (server only) --------------------------------------------------
OPENAI_API_KEY=sk-...
# Vision-capable model used for both text and screenshot analysis
OPENAI_MODEL=gpt-4.1

# --- Google OAuth ----------------------------------------------------------
# Authorized redirect URI: {NEXTAUTH_URL}/api/auth/callback
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...

# --- Supabase --------------------------------------------------------------
# Project Settings > API Keys. New-style keys (sb_...) and legacy JWT keys
# (eyJ...) both work; new projects only have the new style.
SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable key (sb_publishable_...). Not used by the server today.
SUPABASE_ANON_KEY=sb_publishable_...
# Secret key (sb_secret_...). Server-only. Bypasses RLS - never expose it.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# --- Session / app ---------------------------------------------------------
# openssl rand -base64 32
NEXTAUTH_SECRET=replace-me-with-32-bytes-of-random
NEXTAUTH_URL=http://localhost:3000

# --- Token encryption ------------------------------------------------------
# AES-256-GCM key for encrypting Google refresh tokens at rest.
# Must be 32 bytes, base64 encoded: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=replace-me-with-base64-32-bytes

# --- Feature flags ---------------------------------------------------------
# DELETE is implemented end-to-end but disabled in the MVP UI.
ENABLE_DELETE=false
NEXT_PUBLIC_ENABLE_DELETE=false

# --- Defaults --------------------------------------------------------------
DEFAULT_TIMEZONE=Asia/Seoul

# --- Web push (optional) ---------------------------------------------------
# Generate with: npx web-push generate-vapid-keys
# Without these, CalDrop keeps the in-app flow and never offers notifications.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Same value as VAPID_PUBLIC_KEY; the browser needs it to subscribe.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# --- Android app (Trusted Web Activity), served at /.well-known/assetlinks.json
ANDROID_PACKAGE_NAME=
# SHA-256 fingerprints of the app signing key(s), comma separated
# (Play Console > Setup > App signing).
ANDROID_CERT_FINGERPRINTS=

# --- Billing: 14-day free trial, then a $1.99/month Google Play subscription
# Off: nothing is gated. Turn on only once Play billing below is configured,
# or users whose trial ended have no way to pay.
BILLING_ENABLED=false
# Subscription product id created in Play Console > Monetize > Subscriptions.
GOOGLE_PLAY_SUBSCRIPTION_ID=caldrop_monthly
# Service account key JSON (raw or base64) with "View financial data" and
# "Manage orders and subscriptions" in Play Console > Users and permissions.
GOOGLE_PLAY_SERVICE_ACCOUNT=
# Pub/Sub push URL: https://<domain>/api/billing/play/notify?secret=<this>
GOOGLE_PLAY_RTDN_SECRET=

# --- Privacy policy (/privacy) ---------------------------------------------
# Shown as the operator and privacy contact. Kept out of the repo on purpose.
OPERATOR_NAME=
PRIVACY_CONTACT_EMAIL=
# Where the Supabase project lives, e.g. 대한민국 (서울) or 미국 (버지니아)
DATABASE_REGION=
# The same in English, shown on the English policy, e.g. South Korea (Seoul)
DATABASE_REGION_EN=
